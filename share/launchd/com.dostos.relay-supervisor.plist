<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dostos.relay-supervisor</string>

  <!-- Keeps one watcher running per live handoff. Without it a watcher that
       dies for any reason stays dead and its handoff silently stops routing
       escalations, which is indistinguishable from a quiet handoff. -->
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_INSTALL_DIR/relay</string>
    <string>supervise</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:REPLACE_HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPLACE_HOME/Library/Logs/relay-supervisor.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/Library/Logs/relay-supervisor.log</string>
</dict>
</plist>
