<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dostos.relay-viz</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_INSTALL_DIR/relay</string>
    <string>viz</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:REPLACE_HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>REPLACE_HOME/Library/Logs/relay-viz.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/Library/Logs/relay-viz.log</string>
</dict>
</plist>
