# Copy to each remote as ~/.config/relay/host.yaml
# This file is authoritative on the host; local relay only caches it.
version: 1
host_id: REPLACE_WITH_SSH_ALIAS

agents:
  - name: claude
    command: claude
  - name: cursor-agent
    command: cursor-agent
  - name: codex
    command: codex
  - name: ccs:personal
    command: ccs personal
  - name: ccs:hcs
    command: ccs hcs
  - name: codex:1
    command: codex-multi-auth-codex
    args: ["--account", "1"]
    usage_key: codex
  - name: codex:2
    command: codex-multi-auth-codex
    args: ["--account", "2"]
    usage_key: codex

path_map:
  - match: relay
    remote_cwd: ~/gh/relay
  - match: opaquebench
    remote_cwd: ~/gh/opaquebench
  - match: dostos-workspace
    remote_cwd: ~/gh/dostos-workspace

# Shared agent CLI + credential volumes for every container on this host.
# Specs inherit these unless they set toolkit:/home: themselves or
# agent_volumes: false.
agent_volumes:
  toolkit:
    volume: relay-toolkit
    target: /relay/toolkit
    agents: [claude, codex, ccs, cursor-agent]
  home:
    volume: relay-home
    target: /relay/home

defaults:
  preferred_agent: claude
  silence_sec: 45
